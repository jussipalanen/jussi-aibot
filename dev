#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
CMD="${1:-help}"

# Docker Compose helpers
dc() {
  docker compose -f "${PROJECT_DIR}/docker-compose.yml" "$@"
}

die() {
  echo "dev: $*" >&2
  exit 1
}

# ── Cloud Run ────────────────────────────────────────────────────────────────
# Cloud Run commands use gcloud's active project. Environment variables belong to
# the service, so their names need no prefix; secret names are project-wide, so
# they start with jussi-ai-platform-.
CLOUD_RUN_SERVICE="${CLOUD_RUN_SERVICE:-jussi-ai-platform}"
CLOUD_RUN_REGION="${CLOUD_RUN_REGION:-europe-north1}"
SECRET_PREFIX="jussi-ai-platform-"
# The service's variables, secret references and scaling, as deploy.yml sets them.
CLOUD_RUN_ENV_FILE="${PROJECT_DIR}/cloud-run.env.yaml"
CLOUD_RUN_SECRETS="GEMINI_API_KEY=jussi-ai-platform-gemini-api-key:latest"
CLOUD_RUN_SCALING=(--min-instances=1 --max-instances=1 --cpu=1 --memory=512Mi --cpu-throttling --cpu-boost --concurrency=80 --timeout=300)

# Changes made by hand last only until the next deploy.
warn_env_file() {
  echo "Note: the next deploy sets the variables in cloud-run.env.yaml again; change that file to keep this." >&2
}

gcloud_project() {
  command -v gcloud >/dev/null || die "gcloud is not installed"
  PROJECT=$(gcloud config get-value project 2>/dev/null)
  [[ -n $PROJECT ]] || die "no gcloud project; run: gcloud config set project <project-id>"
}

# Runs gcloud run services <command> for the service, e.g. run_service update --update-env-vars A=1.
run_service() {
  local command=$1
  shift
  gcloud run services "$command" "$CLOUD_RUN_SERVICE" --project "$PROJECT" --region "$CLOUD_RUN_REGION" "$@"
}

is_env_key() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

# GEMINI_API_KEY → jussi-ai-platform-gemini-api-key
secret_name() {
  echo "${SECRET_PREFIX}$(tr '[:upper:]_' '[:lower:]-' <<<"$1")"
}

# Asks for KEY's value without showing it and stores it as a new version of its
# secret. Returns 1 when the answer is empty.
store_secret() {
  local key=$1 secret value account
  secret=$(secret_name "$key")
  read -rsp "Value for $key → $secret (not shown, empty skips): " value
  echo
  [[ -n $value ]] || return 1
  if gcloud secrets describe "$secret" --project "$PROJECT" >/dev/null 2>&1; then
    printf %s "$value" | gcloud secrets versions add "$secret" --project "$PROJECT" --data-file=-
  else
    printf %s "$value" | gcloud secrets create "$secret" --project "$PROJECT" --replication-policy=automatic --data-file=-
    # The service runs as its own account, or as the Compute Engine default account.
    account=$(run_service describe --format='value(spec.template.spec.serviceAccountName)' 2>/dev/null || true)
    [[ -n $account ]] || account="$(gcloud projects describe "$PROJECT" --format='value(projectNumber)')-compute@developer.gserviceaccount.com"
    gcloud secrets add-iam-policy-binding "$secret" --project "$PROJECT" \
      --member="serviceAccount:$account" --role=roles/secretmanager.secretAccessor --format=none
  fi
  unset value
}

# Stops before a deploy or apply when a secret is missing: the new revision would
# fail and Cloud Run would mark the service failed.
check_secrets() {
  local ref key missing=()
  IFS=, read -ra refs <<<"$CLOUD_RUN_SECRETS"
  for ref in "${refs[@]}"; do
    key=${ref%%=*}
    gcloud secrets versions describe latest --secret "$(secret_name "$key")" --project "$PROJECT" >/dev/null 2>&1 ||
      missing+=("$key")
  done
  [[ ${#missing[@]} -eq 0 ]] || die "missing secrets: ${missing[*]}; add them with ./dev cloud-env secrets"
}

cloud_env() {
  local action="${1:-list}"
  shift || true
  gcloud_project
  case $action in
    list|values)
      # Plain variables with their values; secrets show the secret's name, and their
      # value only with --values (or the values alias).
      local show_values=0 name secret version
      [[ $action == values || ${1:-} == --values ]] && show_values=1
      run_service describe --format=json | python3 -c '
import json, sys
for e in json.load(sys.stdin)["spec"]["template"]["spec"]["containers"][0].get("env", []):
    ref = e.get("valueFrom", {}).get("secretKeyRef")
    print("\t".join([e["name"], "secret", ref["name"], ref["key"]] if ref else [e["name"], "value", e.get("value", "")]))' |
        while IFS=$'\t' read -r name kind secret version; do
          if [[ $kind == value ]]; then
            echo "$name=$secret"
          elif [[ $show_values == 1 ]]; then
            echo "$name=$(gcloud secrets versions access "$version" --secret "$secret" --project "$PROJECT")"
          else
            echo "$name  (secret $secret:$version)"
          fi
        done
      # Before the first deploy the service runs a placeholder without variables, so
      # show what a deploy would set instead.
      if ! run_service describe --format='value(spec.template.spec.containers[0].env)' | grep -q .; then
        echo "$CLOUD_RUN_SERVICE has no variables yet; a deploy would set these:" >&2
        python3 - "$CLOUD_RUN_ENV_FILE" <<'PY'
import sys
for line in open(sys.argv[1]):
    line = line.split(" #")[0].strip()
    if line and not line.startswith("#") and ":" in line:
        key, value = (part.strip() for part in line.split(":", 1))
        print("%s=%s" % (key, value.strip("'\"")))
PY
        local ref key
        IFS=, read -ra refs <<<"$CLOUD_RUN_SECRETS"
        for ref in "${refs[@]}"; do
          key=${ref%%=*} secret=${ref#*=} secret=${secret%%:*}
          if ! gcloud secrets versions describe latest --secret "$secret" --project "$PROJECT" >/dev/null 2>&1; then
            echo "$key  (secret $secret: MISSING, add it with ./dev cloud-env secrets)"
          elif [[ $show_values == 1 ]]; then
            echo "$key=$(gcloud secrets versions access latest --secret "$secret" --project "$PROJECT")"
          else
            echo "$key  (secret $secret:latest)"
          fi
        done
      fi
      ;;
    apply)
      # Sets exactly the variables in cloud-run.env.yaml without rebuilding.
      check_secrets
      echo "Updating $CLOUD_RUN_SERVICE (project $PROJECT) from cloud-run.env.yaml"
      run_service update --env-vars-file "$CLOUD_RUN_ENV_FILE" --update-secrets "$CLOUD_RUN_SECRETS"
      ;;
    set)
      [[ $# -ge 1 ]] || die "usage: ./dev cloud-env set KEY=VALUE..."
      local pair flags=()
      for pair in "$@"; do
        [[ $pair == *=* ]] && is_env_key "${pair%%=*}" || die "expected KEY=VALUE, got '$pair'"
        # ^@@^ makes @@ the separator, so values may contain commas (e.g. ALLOWED_ORIGINS).
        flags+=(--update-env-vars "^@@^$pair")
      done
      echo "Updating $CLOUD_RUN_SERVICE (project $PROJECT): ${*%%=*}"
      run_service update "${flags[@]}"
      warn_env_file
      ;;
    unset)
      [[ $# -ge 1 ]] || die "usage: ./dev cloud-env unset KEY..."
      local key
      for key in "$@"; do is_env_key "$key" || die "not a variable name: '$key'"; done
      run_service update --remove-env-vars "$(IFS=,; echo "$*")"
      warn_env_file
      ;;
    secret)
      [[ $# -eq 1 ]] && is_env_key "$1" || die "usage: ./dev cloud-env secret KEY"
      local key=$1 secret
      secret=$(secret_name "$key")
      store_secret "$key" || die "empty value"
      # A plain variable with the same name must go first; gcloud cannot turn it into a secret.
      run_service update --update-secrets "$key=$secret:latest"
      [[ ,$CLOUD_RUN_SECRETS, == *,$key=* ]] ||
        echo "Note: add $key=$secret:latest to SECRETS in .github/workflows/deploy.yml and CLOUD_RUN_SECRETS in dev." >&2
      ;;
    secrets)
      # Asks for every secret the deploy needs; an empty answer keeps the current value.
      local ref key missing=()
      IFS=, read -ra refs <<<"$CLOUD_RUN_SECRETS"
      for ref in "${refs[@]}"; do
        key=${ref%%=*}
        store_secret "$key" ||
          gcloud secrets describe "$(secret_name "$key")" --project "$PROJECT" >/dev/null 2>&1 ||
          missing+=("$key")
      done
      [[ ${#missing[@]} -eq 0 ]] || die "still missing: ${missing[*]}; deploys fail until they exist"
      echo "All secrets exist. Deploy with ./dev deploy or a push to main."
      ;;
    *)
      die "usage: ./dev cloud-env list|values|apply|set|unset|secret|secrets"
      ;;
  esac
}

case "${CMD}" in
  up)
    dc up --build -d
    ;;
  down)
    dc down
    ;;
  restart)
    dc restart
    ;;
  logs)
    dc logs -f "${2:-api}"
    ;;
  build)
    dc build
    ;;
  ps)
    dc ps
    ;;
  shell)
    dc exec "${2:-api}" sh
    ;;
  local)
    # Run directly with local venv (original behaviour)
    if [ -x "${PROJECT_DIR}/venv/bin/python" ]; then
      VENV_PYTHON="${PROJECT_DIR}/venv/bin/python"
    elif [ -x "${PROJECT_DIR}/.venv/bin/python" ]; then
      VENV_PYTHON="${PROJECT_DIR}/.venv/bin/python"
    else
      echo "Error: no venv found. Create one first:"
      echo "  python3 -m venv venv && pip install -r requirements.txt"
      exit 1
    fi
    HOST="${HOST:-127.0.0.1}"
    PORT="${PORT:-8001}"
    exec "${VENV_PYTHON}" -m uvicorn main:app --reload --host "${HOST}" --port "${PORT}"
    ;;
  test)
    # Run pytest inside the container (all deps already installed)
    dc run --rm \
      -e DEFAULT_PROVIDER=puter_ai \
      -e DISABLE_LOCAL_MODEL=true \
      --no-deps \
      api python -m pytest "${2:---tb=short}" -v
    ;;
  test-local)
    # Run pytest with local venv
    if [ -x "${PROJECT_DIR}/venv/bin/python" ]; then
      VENV_PYTHON="${PROJECT_DIR}/venv/bin/python"
    elif [ -x "${PROJECT_DIR}/.venv/bin/python" ]; then
      VENV_PYTHON="${PROJECT_DIR}/.venv/bin/python"
    else
      echo "Error: no venv found. Create one first:"
      echo "  python3 -m venv venv && pip install -r requirements.txt pytest httpx"
      exit 1
    fi
    exec "${VENV_PYTHON}" -m pytest "${2:---tb=short}" -v
    ;;
  generate-postman)
    OUTPUT="${2:-postman/postman_collection.json}"
    BASE_URL="${3:-http://localhost:8080}"
    # Run inside the container where all deps are already installed
    dc run --rm \
      -e DEFAULT_PROVIDER=puter_ai \
      -e DISABLE_LOCAL_MODEL=true \
      -v "${PROJECT_DIR}:/app" \
      --no-deps \
      api python scripts/generate_postman.py --output "${OUTPUT}" --base-url "${BASE_URL}"
    echo "Collection saved to: ${PROJECT_DIR}/${OUTPUT}"
    ;;
  deploy)
    # Builds the Dockerfile with Cloud Build and deploys a new revision with the
    # variables in cloud-run.env.yaml, the secrets and the scaling, as deploy.yml does.
    # Extra args go to gcloud run deploy, e.g. ./dev deploy --quiet
    shift
    gcloud_project
    check_secrets
    echo "Deploying $CLOUD_RUN_SERVICE to Cloud Run (project $PROJECT, region $CLOUD_RUN_REGION)."
    exec gcloud run deploy "$CLOUD_RUN_SERVICE" --source "$PROJECT_DIR" --project "$PROJECT" \
      --region "$CLOUD_RUN_REGION" --env-vars-file "$CLOUD_RUN_ENV_FILE" \
      --update-secrets "$CLOUD_RUN_SECRETS" "${CLOUD_RUN_SCALING[@]}" "$@"
    ;;
  cloud-env)
    shift
    cloud_env "$@"
    ;;
  help|--help|-h)
    echo "Usage: ./dev <command> [args]"
    echo ""
    echo "Commands:"
    echo "  up                          Build and start containers in background"
    echo "  down                        Stop and remove containers"
    echo "  restart                     Restart running containers"
    echo "  logs [svc]                  Follow logs (default: api)"
    echo "  build                       Rebuild images without starting"
    echo "  ps                          Show container status"
    echo "  shell [svc]                 Open shell in container (default: api)"
    echo "  local                       Run locally with venv (no Docker)"
    echo "  test [pytest-args]          Run pytest inside the container"
    echo "  test-local [pytest-args]    Run pytest with local venv"
    echo "  generate-postman [out] [url] Generate Postman collection (default: postman/postman_collection.json, http://localhost:8080)"
    echo ""
    echo "Cloud Run (gcloud's active project; service ${CLOUD_RUN_SERVICE}, ${CLOUD_RUN_REGION}):"
    echo "  deploy [args]               Build and deploy this working copy with cloud-run.env.yaml and the"
    echo "                              secrets; args go to gcloud run deploy, e.g. ./dev deploy --quiet"
    echo "  cloud-env list [--values]   Show the service's variables; secrets by name, or with --values"
    echo "                              their values too (shown in plain text)"
    echo "  cloud-env values            Same as cloud-env list --values"
    echo "  cloud-env apply             Set exactly the variables in cloud-run.env.yaml, without rebuilding"
    echo "  cloud-env set KEY=VALUE...  Add or change variables until the next deploy; to keep a value,"
    echo "                              change cloud-run.env.yaml instead"
    echo "  cloud-env unset KEY...      Remove variables until the next deploy"
    echo "  cloud-env secret KEY        Ask for a value without showing it, store it in Secret Manager as"
    echo "                              ${SECRET_PREFIX}<key> and give it to the service as KEY"
    echo "  cloud-env secrets           Ask for every secret the deploy needs (empty keeps the current one)"
    ;;
  *)
    echo "Unknown command: ${CMD}"
    echo "Run './dev help' for usage."
    exit 1
    ;;
esac

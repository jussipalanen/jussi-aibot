# Example environment variables for local development.
# Copy to .env and fill in what you need. Every variable is optional unless noted.

PORT=8080

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Jussi AI Bot
# APP_DESCRIPTION=A configurable AI agent platform...
# CONFIG_DIR=./config            # agents/ and rubrics/ live here

# ── AI providers ────────────────────────────────────────────────────────────
# Gemini with an API key from https://aistudio.google.com (works on any host).
GEMINI_API_KEY=
# ...or Gemini through Vertex AI with Google credentials (used when GEMINI_API_KEY is empty).
GCP_PROJECT=
GCP_LOCATION=europe-north1
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json   # outside Google Cloud only
# GEMINI_MODEL=gemini-2.5-flash-lite                      # default model for reviews
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Puter AI (text only; used by the legacy review with provider=puter_ai)
PUTER_API_KEY=
PUTER_MODEL=gpt-4o-mini
PUTER_DRIVER=openai-completion

# OpenAI-compatible providers: set <NAME>_API_KEY and <NAME>_MODEL
# (NAME = OPENAI, GROQ, OPENROUTER, MISTRAL, OLLAMA, OPENAI_COMPAT).
# GROQ_API_KEY=
# GROQ_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=

# Local Finnish model (needs INCLUDE_ML_DEPS=1 and lots of memory)
DISABLE_LOCAL_MODEL=true

# ── Agents (config/agents/*.yaml) ───────────────────────────────────────────
# AGENT_PROVIDER=gemini
# AGENT_VERTEX_MODEL=gemini-2.5-flash-lite      # default model for all agents
# JUSSISPACE_VERTEX_MODEL=                      # per-agent overrides
# JUSSIMATIC_CV_VERTEX_MODEL=

JUSSISPACE_API_URL=https://backend-lab-jussispace.jussialanen.com/api
# Docker on WSL2: use http://host.docker.internal:3000/api to reach a backend on the host.
JUSSISPACE_FRONTEND_URL=https://jussispace-production.lab.jussialanen.com
AGENT_EMAIL=agent@jussispace.internal
AGENT_PASSWORD=your-agent-password

JUSSIMATIC_CV_API_URL=
JUSSILOG_STORAGE_BASE_URL=https://jussilog-backend-uploads.storage.googleapis.com

# ── Reviews ─────────────────────────────────────────────────────────────────
REVIEW_PROVIDER=gemini         # default provider for POST /v1/review
DEFAULT_PROVIDER=vertex_ai     # default provider for POST /ai/review: default, puter_ai or vertex_ai
VERTEX_PROMPT_MAX_CHARS=6000
PUTER_PROMPT_MAX_CHARS=6000
# MAX_UPLOAD_MB=50

# ── Access ──────────────────────────────────────────────────────────────────
# Per-client keys, origins and limits: copy config/clients.example.yaml to
# config/clients.yaml, or point CLIENTS_FILE at it.
# CLIENTS_FILE=

# Without a clients file, these single-client settings are used.
# Both empty = no authentication (local dev only).
# Generate a key: openssl rand -hex 32
AI_SECRET_KEY=
ALLOWED_ORIGINS=

DAILY_RATE_LIMIT=50/day
# Use the Nth address from the right of X-Forwarded-For as the client IP (0 = off).
FORWARDED_IP_DEPTH=0
# LOG_FORWARDED_FOR=true        # log the header once to find the right depth

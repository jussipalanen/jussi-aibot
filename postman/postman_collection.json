{
  "info": {
    "_postman_id": "df952b45-f674-46f9-af56-67f54ba253b4",
    "name": "Jussi AI Bot",
    "description": "\nA configurable AI agent platform: chat agents with tools and RAG, and document reviews, behind one API.\n\n**Authentication:** send `Authorization: Bearer <key>` from servers. Browser\nclients listed in the clients config are identified by their `Origin` instead.\nLocal development without any clients configured needs no authentication.\n\n**Rate limits:** per client, per IP address, for chat and review separately.\nExceeding a limit returns `429` with a `Retry-After` header.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "AI_SECRET_KEY",
      "value": "",
      "type": "secret"
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Service home",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{AI_SECRET_KEY}}",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
              "raw": "http://localhost:8080/",
              "host": [
                "http://localhost:8080"
              ],
              "path": []
            },
            "description": "A small home page with links to the demos and documentation. Returns JSON when the client asks for it."
          },
          "response": []
        },
        {
